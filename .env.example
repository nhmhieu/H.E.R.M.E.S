# H.E.R.M.E.S AI & Security Configuration
# Chế độ chạy AI: "mock" (mặc định, ngoại tuyến, dùng cho test/CI) hoặc "gemini" (gọi API thật)
HERMES_AI_MODE=mock

# Gemini API Key (Lấy tại https://aistudio.google.com/ - KHÔNG commit key thật lên Git)
GEMINI_API_KEY=your_gemini_api_key_here

# Tên model Gemini sử dụng khi HERMES_AI_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash

# Giới hạn độ dài tối đa của câu hỏi đầu vào (ký tự)
HERMES_MAX_INPUT_LENGTH=1000
